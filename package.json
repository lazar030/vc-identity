{
  "name": "vc-identity",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api": "node server/server.cjs",
    "dev": "concurrently -n api,web -c blue,green \"npm:api\" \"npm:start\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "storybook": "ng run vc-identity:storybook",
    "build-storybook": "ng run vc-identity:build-storybook",
    "test-storybook": "test-storybook",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "compare:figma": "node scripts/compare-figma.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@compodoc/compodoc": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^9.1.21",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/addon-onboarding": "^9.1.21",
    "@storybook/angular": "^9.1.21",
    "@storybook/test-runner": "^0.26.0",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "jasmine-core": "~5.6.0",
    "json-server": "^0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.31",
    "storybook": "^9.1.21",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2"
  }
}
